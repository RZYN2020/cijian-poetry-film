          "items": {
            "type": "string"
          },
          "title": "Tone",
          "type": "array"
        },
        "avoid": {
          "default": [
            "鸡汤",
            "营销",
            "过度煽情",
            "作者介绍开场",
            "虚构作者生平"
          ],
          "items": {
            "type": "string"
          },
          "title": "Avoid",
          "type": "array"
        }
      },
      "required": [
        "poem_title",
        "author",
        "poem_text",
        "emotion",
        "modern_moment"
      ],
      "title": "Brief",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "brief": {
      "$ref": "#/$defs/Brief"
    },
    "research": {
      "default": "research.json",
      "title": "Research",
      "type": "string"
    },
    "script": {
      "default": "script.json",
      "title": "Script",
      "type": "string"
    },
    "storyboard": {
      "default": "storyboard.json",
      "title": "Storyboard",
      "type": "string"
    },
    "output": {
      "default": "output.mp4",
      "title": "Output",
      "type": "string"
    },
    "created_at": {
      "minLength": 1,
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "brief",
    "created_at"
  ],
  "title": "ContentProject",
  "type": "object"
