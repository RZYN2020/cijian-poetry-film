          "minLength": 1,
          "title": "Poem Title",
          "type": "string"
        },
        "author": {
          "minLength": 1,
          "title": "Author",
          "type": "string"
        },
        "poem_text": {
          "minLength": 1,
          "title": "Poem Text",
          "type": "string"
        },
        "emotion": {
          "minLength": 1,
          "title": "Emotion",
          "type": "string"
        },
        "modern_moment": {
          "minLength": 1,
          "title": "Modern Moment",
          "type": "string"
        },
        "target_seconds": {
          "default": 60,
          "maximum": 120,
          "minimum": 30,
          "title": "Target Seconds",
          "type": "number"
        },
        "tone": {
          "default": [
            "克制",
            "安静",
            "含蓄",
