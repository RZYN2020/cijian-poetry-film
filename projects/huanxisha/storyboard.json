  "scenes": [
    {
      "id": "s01",
      "duration": 6.041666666666667,
      "narration": "很多年后，你又经过放学时走的那条路。",
      "subtitle": [
        {
          "start": 0.35,
          "end": 1.6604166666666669,
          "text": "很多年后，"
        },
        {
          "start": 1.6604166666666669,
          "end": 5.591666666666667,
          "text": "你又经过放学时走的那条路。"
        }
      ],
      "visual_intent": "街巷纵深，极慢前推。没有主角特写，留出观者自己的记忆。",
      "asset_refs": [
        "old-street"
      ],
      "claim_ids": [],
      "role": "modern_moment",
      "quote": "",
      "audio": null
    },
    {
      "id": "s02",
      "duration": 6.041666666666667,
      "narration": "店招换了。拐角还在。你下意识慢了半步。",
      "subtitle": [
        {
          "start": 0.35,
          "end": 2.9708333333333337,
          "text": "店招换了。拐角还在。"
        },
        {
          "start": 2.9708333333333337,
          "end": 5.591666666666667,
          "text": "你下意识慢了半步。"
        }
      ],
      "visual_intent": "雨将窗外景物稍稍模糊，接住停顿；不是模拟真实事件。",
      "asset_refs": [
        "rain"
      ],
      "claim_ids": [],
      "role": "emotion",
      "quote": "",
      "audio": null
    },
    {
      "id": "s03",
      "duration": 8.125,
      "narration": "去年天气旧亭台。原来，有些地方，一到那里，就会想起从前。",
      "subtitle": [
        {
          "start": 0.35,
          "end": 2.5793478260869565,
          "text": "去年天气旧亭台。"
        },
        {
          "start": 2.5793478260869565,
          "end": 4.490217391304348,
          "text": "原来，有些地方，"
        },
        {
          "start": 4.490217391304348,
          "end": 7.675000000000001,
          "text": "一到那里，就会想起从前。"
        }
      ],
      "visual_intent": "园林水边的亭台；将“去年”的感觉落到仍在眼前的建筑。",
      "asset_refs": [
        "garden"
      ],
      "claim_ids": [
        "c-old"
      ],
      "role": "poem_enters",
      "quote": "去年天气旧亭台",
      "audio": null
    },
    {
      "id": "s04",
      "duration": 9.666666666666666,
      "narration": "北宋的晏殊，把这种恍惚写进《浣溪沙》。一曲新词，一杯酒，亭台却是旧的。",
      "subtitle": [
        {
          "start": 0.35,
          "end": 1.9333333333333331,
          "text": "北宋的晏殊，"
        },
        {
          "start": 1.9333333333333331,
          "end": 5.1,
          "text": "把这种恍惚写进《浣溪沙》。"
        },
        {
          "start": 5.1,
          "end": 7.316666666666666,
          "text": "一曲新词，一杯酒，"
        },
        {
          "start": 7.316666666666666,
          "end": 9.216666666666667,
          "text": "亭台却是旧的。"
        }
      ],
      "visual_intent": "公版古画中的山水与夕照；背景只在此处轻轻进入。",
      "asset_refs": [
        "painting"
      ],
      "claim_ids": [
        "c-text",
        "c-period",
        "c-old"
      ],
      "role": "context",
      "quote": "",
      "audio": null
    },
    {
      "id": "s05",
      "duration": 5.416666666666667,
      "narration": "无可奈何花落去，似曾相识燕归来。",
      "subtitle": [
        {
          "start": 0.35,
          "end": 2.6583333333333337,
          "text": "无可奈何花落去，"
        },
        {
          "start": 2.6583333333333337,
          "end": 4.966666666666667,
          "text": "似曾相识燕归来。"
        }
      ],
      "visual_intent": "落花仍停留在地面，镜头不追逐花瓣。词句完整留给声音。",
      "asset_refs": [
        "petals"
      ],
      "claim_ids": [
        "c-return"
      ],
      "role": "rereading",
      "quote": "无可奈何花落去，似曾相识燕归来",
      "audio": null
    },
    {
      "id": "s06",
      "duration": 7.541666666666667,
      "narration": "花落了，燕子又回来了。“似曾相识”，终究隔着一个“似”字。",
      "subtitle": [
        {
          "start": 0.35,
          "end": 3.2392857142857148,
          "text": "花落了，燕子又回来了。"
        },
        {
          "start": 3.2392857142857148,
          "end": 4.523412698412699,
          "text": "“似曾相识”，"
        },
        {
          "start": 4.523412698412699,
          "end": 7.091666666666667,
          "text": "终究隔着一个“似”字。"
        }
      ],
      "visual_intent": "家燕静静停栖，不做飞行的拟真动画；微小后移。",
      "asset_refs": [
