    {
      "id": "s05",
      "duration": 4.666666666666667,
      "narration": "无可奈何花落去，似曾相识燕归来。",
      "subtitle": [
        {
          "start": 0.35,
          "end": 2.1746485,
          "text": "无可奈何花落去，"
        },
        {
          "start": 2.1746485,
          "end": 3.999297,
          "text": "似曾相识燕归来。"
        }
      ],
      "visual_intent": "落花仍停留在地面，镜头不追逐花瓣。词句完整留给声音。",
