    {
      "id": "s04",
      "duration": 8.791666666666666,
      "narration": "北宋的晏殊，把这种恍惚写进《浣溪沙》。一曲新词，一杯酒，亭台却是旧的。",
      "subtitle": [
        {
          "start": 0.35,
          "end": 1.736969464285714,
          "text": "北宋的晏殊，"
        },
        {
          "start": 1.736969464285714,
          "end": 4.510908392857143,
          "text": "把这种恍惚写进《浣溪沙》。"
        },
        {
          "start": 4.510908392857143,
          "end": 6.452665642857142,
          "text": "一曲新词，一杯酒，"
        },
        {
          "start": 6.452665642857142,
          "end": 8.117029,
          "text": "亭台却是旧的。"
        }
      ],
      "visual_intent": "公版古画中的山水与夕照；背景只在此处轻轻进入。",
